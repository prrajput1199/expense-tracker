# --- Pick ONE database URL -------------------------------------------------
# PostgreSQL (default for docker-compose)
DATABASE_URL=postgresql+psycopg2://expense_user:expense_pass@localhost:5432/expense_db

# MySQL
# DATABASE_URL=mysql+pymysql://expense_user:expense_pass@localhost:3306/expense_db

# SQLite (zero-setup local development)
# DATABASE_URL=sqlite:///./expenses.db

# Allowed browser origins (JSON list)
CORS_ORIGINS=["http://localhost:5173"]
